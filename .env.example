BILLING_SUCCESS_URL=https://<host>/shops/menu/<storeId>?lang=en
BILLING_CANCEL_URL=https://<host>/shops/info/<storeId>?lang=en

# Gemini API + Genkit
GEMINI_API_KEY=AIza...
GEMINI_MODEL_FLASH=gemini-2.5-flash
