{
  "name": "@tonosama/pwa-guest",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --port 3010",
    "stop": "sh ./scripts/stop-guest.sh 3010",
    "build": "rm -rf .next && next build",
    "build:static": "sh ./scripts/build-static-fallback.sh out-static",
    "start": "next start --port 3010",
    "typecheck": "tsc --noEmit --incremental false",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.3"
  }
}
